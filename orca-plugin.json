{
  "manifestVersion": 2,
  "id": "tetris-for-orca",
  "name": "Tetris for Orca",
  "version": "0.5.2",
  "description": "Retro Tetris, Ladder, Snake and Minesweeper games in the Orca sidebar.",
  "license": "MIT",
  "repository": "https://github.com/vrwolf1004/orca-tetris",
  "author": {
    "name": "vrwolf1004"
  },
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "sandboxed-ui",
  "contributes": {
    "panels": [
      {
        "id": "tetris",
        "title": "Tetris",
        "entry": "panel/index.html"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "docs/store/store-cover.webp",
    "alt": "Tetris for Orca: a Tetris board next to the title"
  },
  "screenshots": [
    {
      "path": "docs/store/store-screenshots.webp",
      "alt": "Tetris, Ladder, Snake and Minesweeper panels side by side",
      "caption": "Four games in the Orca sidebar"
    },
    {
      "path": "docs/store/land-tetris.webp",
      "alt": "Tetris game screen",
      "caption": "Tetris in the Orca sidebar"
    },
    {
      "path": "docs/store/land-ladder.webp",
      "alt": "Ladder game screen",
      "caption": "Ladder in the Orca sidebar"
    },
    {
      "path": "docs/store/land-snake.webp",
      "alt": "Snake game screen",
      "caption": "Snake in the Orca sidebar"
    },
    {
      "path": "docs/store/land-minesweeper.webp",
      "alt": "Minesweeper game screen",
      "caption": "Minesweeper in the Orca sidebar"
    }
  ]
}
